       (instances (project "C5VRX_JACK_DIY_V2" (path "/3f7e44b9-0d23-4154-a2e9-c50963f7f4c3" (reference "#FLG03") (unit 1))))) (label "GND" (at 64.77 157.48 0) (effects (font (size 1.0 1.0))) (uuid d8263277-b3c2-4291-a790-56459e79497b)) (text "C5VRX_JACK_DIY_V2 / FAT SHARK DOMINATOR + 3.5MM AV - XIAO THT CARRIER" (at 30.48 30.48 0) (effects (font (size 2 2)) (justify left top)) (uuid 17ed94c9-770b-4215-8d14-afd63b45e7db)) (text "Only 5V, GND and VIDEO connected at the goggle bay.\nD4..D9 = DAC bit 0..5. Use XIAO firmware pin mapping.\nR1..R7: upstream C5VRX-5 values, 1% recommended." (at 30.48 39.37 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid aabf9a93-ce5c-4bd8-93e1-8ec35215d17a)) (text "J1: pin 1 = bottom / 5V; pin 9 = top.\nComponent side: header RIGHT, USB LEFT.\nUnused bay pins intentionally unconnected." (at 190.5 107.95 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid 616d5db6-38a4-40a1-8913-f7b7ac51f7cb)) (text "SJ1: solder bridge for bay power.\nOpen SJ1 before USB programming.\nXIAO BOOT button controls the firmware menu." (at 83.82 146.05 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid 4b86ecf7-a45d-4b5e-9b15-f040d24798b6)) (text "R1..R7: axial through-hole, DIN0207 / 0.25W, 10.16 mm lead pitch.\nXIAO: plug-in mounting on 2 x 7-pin headers.\nDecoupling is provided on the XIAO module." (at 30.48 166.37 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid f719152d-e4bb-4fb8-9c79-b5c3385384d1)) (text "LOCAL FIRMWARE BOM OPTION (same PCB):\nR1 7.87k, R2 3.92k, R3 1.96k, R4 976, R5 487, R6 243, R7 191.\nChoose one complete DAC set to match the firmware. No extra 75-ohm shunt." (at 30.48 179.07 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid 2c355071-3d50-4fb7-b98a-2cc396a7b4a5)) (sheet_instances (path "/" (page "1"))) (embedded_fonts no)
