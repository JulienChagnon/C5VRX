# Opt-in XIAO ESP32-C5HR8 image; requires working in-package PSRAM.
# Wi-Fi BSS and EXT_RAM_BSS_ATTR buffers move out of internal SRAM.
# CAPS_ALLOC keeps ordinary allocations and the video path internal.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
